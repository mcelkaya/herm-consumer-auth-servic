# Application
APP_NAME=Email Integration Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_integration
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT Authentication
SECRET_KEY=a81993cf4d9402d04425e3706c81940f91c20672f23c837d7221ea617ad44495
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Logging
LOG_LEVEL=INFO

# ---- Slack alert notifications ----
# Incoming Webhook URL for ops/system alerts (critical + warning). Leave blank
# in dev → no-op (nothing is sent). In prod injected from SSM
# (prod_slack_auth_alerts_webhook) via the ECS task definition.
ALERT_SLACK_WEBHOOK=
