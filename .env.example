# Application
APP_NAME=Email Integration Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_integration
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:8433/test_email_integration

# JWT Authentication
# Access tokens are RS256-only (no SECRET_KEY / HS256 any more). The service
# refuses to start without a keyset. Generate a local dev keyset (never reuse prod's):
#   printf "ACCESS_TOKEN_SIGNING_KEYS='%s'\n" "$(python scripts/generate_access_token_keypair.py)" >> .env
# (printf, not echo: zsh's echo turns the PEM's \n escapes into real newlines)
ACCESS_TOKEN_ALGORITHM=RS256
# ACCESS_TOKEN_SIGNING_KEYS='{"active": "at-...", "keys": {"at-...": "-----BEGIN PRIVATE KEY-----\n..."}}'
# ACCESS_TOKEN_AUDIENCE=herm-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Logging
LOG_LEVEL=INFO

# ---- Slack alert notifications ----
# Incoming Webhook URL for ops/system alerts (critical + warning). Leave blank
# in dev → no-op (nothing is sent). In prod injected from SSM
# (prod_slack_auth_alerts_webhook) via the ECS task definition.
ALERT_SLACK_WEBHOOK=
