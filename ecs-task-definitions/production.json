{
  "containerDefinitions": [
    {
      "name": "prod-auth",
      "image": "373352901774.dkr.ecr.eu-central-1.amazonaws.com/auth:__IMAGE_TAG__",
      "cpu": 0,
      "portMappings": [
        {
          "name": "backend-8000-tcp",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "dependsOn": [
        {
          "containerName": "otel-collector",
          "condition": "START"
        }
      ],
      "environment": [
        {
          "name": "JWT_ENFORCE_MIN_KEY_LENGTH",
          "value": "true"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "ALGORITHM",
          "value": "HS256"
        },
        {
          "name": "ACCESS_TOKEN_EXPIRE_MINUTES",
          "value": "30"
        },
        {
          "name": "REFRESH_TOKEN_EXPIRE_DAYS",
          "value": "7"
        },
        {
          "name": "DATABASE_POOL_SIZE",
          "value": "20"
        },
        {
          "name": "DATABASE_MAX_OVERFLOW",
          "value": "10"
        },
        {
          "name": "DATABASE_SCHEMA",
          "value": "herm_auth"
        },
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        },
        {
          "name": "COOKIE_DOMAIN",
          "value": ".herm.io"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://app.herm.io"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://app.herm.io,https://wizard.herm.io,https://ministry.herm.io"
        },
        {
          "name": "CONSUMER_INTERNAL_BASE_URL",
          "value": "http://prod-consumer:8000/herm-consumer/v1/internal"
        },
        {
          "name": "CONSUMER_INTERNAL_TIMEOUT_SECONDS",
          "value": "5"
        },
        {
          "name": "DEBUG",
          "value": "false"
        },
        {
          "name": "GOOGLE_CLIENT_IDS",
          "value": "934396523951-me00jr2s650c6cebkqcufu76c5hq5mne.apps.googleusercontent.com,934396523951-d49mkp2amoe40n3kipr1bc5hinqoo2g4.apps.googleusercontent.com,934396523951-o4vp3nok689ku6rbd7vqi43bj7520onn.apps.googleusercontent.com"
        },
        {
          "name": "APPLE_CLIENT_IDS",
          "value": "io.herm.mobile"
        },
        {
          "name": "APPLE_TEAM_ID",
          "value": "STNJ32J4MC"
        },
        {
          "name": "APPLE_KEY_ID",
          "value": "4687X3S96S"
        },
        {
          "name": "FACEBOOK_APP_ID",
          "value": "4319859038272210"
        },
        {
          "name": "FACEBOOK_EMAIL_VERIFIED_DEFAULT",
          "value": "true"
        },
        {
          "name": "OIDC_PROVIDER_ENABLED",
          "value": "true"
        },
        {
          "name": "OIDC_ISSUER",
          "value": "https://api.herm.io/herm-auth"
        },
        {
          "name": "OIDC_FLOWS_ENABLED",
          "value": "true"
        },
        {
          "name": "OIDC_CONSENT_URL",
          "value": "https://app.herm.io/connect/consent"
        },
        {
          "name": "OIDC_ERROR_URL",
          "value": "https://app.herm.io/connect/error"
        },
        {
          "name": "OTEL_SERVICE_NAME",
          "value": "herm-consumer-auth-service"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "value": "http://localhost:4318"
        },
        {
          "name": "OTEL_TRACES_SAMPLER",
          "value": "parentbased_traceidratio"
        },
        {
          "name": "OTEL_TRACES_SAMPLER_ARG",
          "value": "0.2"
        },
        {
          "name": "OTEL_METRICS_EXPORTER",
          "value": "none"
        },
        {
          "name": "OTEL_LOGS_EXPORTER",
          "value": "none"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:373352901774:secret:prod/herm/auth/db-url-TyQ5sa:DATABASE_URL::"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_secret_key"
        },
        {
          "name": "NOTIFICATION_QUEUE_URL",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-notification-queue_url"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_redis_url"
        },
        {
          "name": "CONSUMER_INTERNAL_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-internal_api_key"
        },
        {
          "name": "INTERNAL_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-internal_api_key"
        },
        {
          "name": "FACEBOOK_APP_SECRET",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-facebook_app_secret"
        },
        {
          "name": "APPLE_PRIVATE_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_apple_signin_private_key"
        },
        {
          "name": "ALERT_SLACK_WEBHOOK",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_slack_auth_alerts_webhook"
        },
        {
          "name": "OIDC_SIGNING_KEY_ARN",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_oidc_signing_key_arn"
        },
        {
          "name": "WIZARD_AUTH_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_wizard_auth_key"
        },
        {
          "name": "OIDC_PPID_SECRET",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_oidc_ppid_secret"
        },
        {
          "name": "OIDC_STATE_ENC_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_oidc_state_enc_key"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "prod/ecs/auth-logs",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      }
    },
    {
      "name": "otel-collector",
      "image": "public.ecr.aws/aws-observability/aws-otel-collector:v0.50.0",
      "cpu": 64,
      "memory": 256,
      "memoryReservation": 128,
      "essential": false,
      "environment": [
        {
          "name": "AOT_CONFIG_CONTENT",
          "value": "extensions:\n  health_check:\n    endpoint: 127.0.0.1:13133\nreceivers:\n  otlp:\n    protocols:\n      http:\n        endpoint: 127.0.0.1:4318\nprocessors:\n  batch/traces:\n    timeout: 1s\n    send_batch_size: 50\nexporters:\n  awsxray:\n    region: eu-central-1\n    indexed_attributes: [herm.run_id, herm.llm.task, messaging.destination.name, gen_ai.request.model]\nservice:\n  extensions: [health_check]\n  pipelines:\n    traces:\n      receivers: [otlp]\n      processors: [batch/traces]\n      exporters: [awsxray]\n"
        }
      ],
      "healthCheck": {
        "command": [
          "/healthcheck"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "prod/ecs/auth-logs",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "otel"
        },
        "secretOptions": []
      }
    }
  ],
  "family": "prod-auth",
  "executionRoleArn": "arn:aws:iam::373352901774:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::373352901774:role/hermAuthTaskRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}