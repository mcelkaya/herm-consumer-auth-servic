{
  "containerDefinitions": [
    {
      "name": "prod-auth",
      "image": "373352901774.dkr.ecr.eu-central-1.amazonaws.com/auth:__IMAGE_TAG__",
      "cpu": 0,
      "portMappings": [
        {
          "name": "backend-8000-tcp",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "ALGORITHM",
          "value": "HS256"
        },
        {
          "name": "ACCESS_TOKEN_EXPIRE_MINUTES",
          "value": "30"
        },
        {
          "name": "REFRESH_TOKEN_EXPIRE_DAYS",
          "value": "7"
        },
        {
          "name": "DATABASE_POOL_SIZE",
          "value": "20"
        },
        {
          "name": "DATABASE_MAX_OVERFLOW",
          "value": "10"
        },
        {
          "name": "DATABASE_SCHEMA",
          "value": "herm_auth"
        },
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "PORT",
          "value": "8000"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://app.herm.io"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://app.herm.io,https://wizard.herm.io,https://ministry.herm.io"
        },
        {
          "name": "CONSUMER_INTERNAL_BASE_URL",
          "value": "http://prod-consumer:8000/herm-consumer/v1/internal"
        },
        {
          "name": "CONSUMER_INTERNAL_TIMEOUT_SECONDS",
          "value": "5"
        },
        {
          "name": "DEBUG",
          "value": "true"
        },
        {
          "name": "GOOGLE_CLIENT_IDS",
          "value": "934396523951-me00jr2s650c6cebkqcufu76c5hq5mne.apps.googleusercontent.com,934396523951-d49mkp2amoe40n3kipr1bc5hinqoo2g4.apps.googleusercontent.com,934396523951-o4vp3nok689ku6rbd7vqi43bj7520onn.apps.googleusercontent.com"
        },
        {
          "name": "APPLE_CLIENT_IDS",
          "value": "io.herm.mobile"
        },
        {
          "name": "FACEBOOK_APP_ID",
          "value": "4319859038272210"
        },
        {
          "name": "FACEBOOK_EMAIL_VERIFIED_DEFAULT",
          "value": "true"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:373352901774:secret:prod/herm/auth/db-url-TyQ5sa:DATABASE_URL::"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_secret_key"
        },
        {
          "name": "NOTIFICATION_QUEUE_URL",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-notification-queue_url"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_redis_url"
        },
        {
          "name": "CONSUMER_INTERNAL_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-internal_api_key"
        },
        {
          "name": "INTERNAL_API_KEY",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-internal_api_key"
        },
        {
          "name": "FACEBOOK_APP_SECRET",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod-facebook_app_secret"
        },
        {
          "name": "ALERT_SLACK_WEBHOOK",
          "valueFrom": "arn:aws:ssm:eu-central-1:373352901774:parameter/prod_slack_auth_alerts_webhook"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "prod/ecs/auth-logs",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      }
    }
  ],
  "family": "prod-auth",
  "executionRoleArn": "arn:aws:iam::373352901774:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::373352901774:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}