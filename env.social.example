# =============================================================================
# Social login (Google / Apple / Facebook)
# Append these to your .env and .env.example. Replace every TODO_* value with
# the real one from the provider consoles (see the platform setup guide).
# =============================================================================

# --- Google ------------------------------------------------------------------
# Comma-separated list of EVERY Google OAuth client id whose ID token you accept.
# Include your Web/"server" client id (used as webClientId in the RN app), plus
# the iOS and Android client ids. The ID token's `aud` must match one of these.
GOOGLE_CLIENT_IDS=TODO_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com,TODO_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com,TODO_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com

# --- Apple -------------------------------------------------------------------
# Comma-separated Apple client ids. For the native app this is your iOS bundle
# id. Add your web Services ID too if you ever do Sign in with Apple on the web.
APPLE_CLIENT_IDS=TODO_APPLE_BUNDLE_ID

# --- Facebook (Meta) ---------------------------------------------------------
FACEBOOK_APP_ID=TODO_FACEBOOK_APP_ID
# App secret — needed to validate classic (Android) access tokens. Store this in
# AWS Secrets Manager / SSM in production, NOT in plaintext env.
FACEBOOK_APP_SECRET=TODO_FACEBOOK_APP_SECRET
# Set to false for strictest linking (forces Facebook links via the settings
# page instead of auto-linking a matched email). Default true.
FACEBOOK_EMAIL_VERIFIED_DEFAULT=true
